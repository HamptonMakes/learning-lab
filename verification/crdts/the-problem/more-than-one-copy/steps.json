    {
      "index": 4,
      "stepId": "s04",
      "sceneId": "copies",
      "say": "Three copies. Right now they all agree.",
      "file": "05-copies-s04.png"
    },
    {
      "index": 5,
      "stepId": "s05",
      "sceneId": "copies",
      "say": "Alice changes the title on her phone.",
      "file": "06-copies-s05.png"
    },
    {
      "index": 6,
      "stepId": "s06",
      "sceneId": "copies",
      "say": "At the same moment, Bob changes it too. He has not seen Alice's change.",
      "file": "07-copies-s06.png"
    },
    {
      "index": 7,
      "stepId": "s07",
      "sceneId": "copies",
      "say": "Whoops — now we have a problem. Two copies disagree, and neither one is a mistake.",
      "file": "08-copies-s07.png"
    },
    {
      "index": 8,
      "stepId": "s08",
      "sceneId": "copies",
      "say": "Alice saves first. The server takes her title.",
      "file": "09-copies-s08.png"
    },
    {
      "index": 9,
      "stepId": "s09",
      "sceneId": "copies",
      "say": "Bob saves a moment later. The server takes his title.",
      "file": "10-copies-s09.png"
    },
    {
      "index": 10,
      "stepId": "s10",
      "sceneId": "copies",
      "say": "On the server, Alice's change is gone. Nobody was told.",
      "file": "11-copies-s10.png"
    },
    {
      "index": 11,
      "stepId": "s11",
      "sceneId": "copies",
      "say": "More than one copy, two writes at the same time, and no rule for what should happen. That is the whole course in one picture.",
      "file": "12-copies-s11.png"
    },
    {
      "index": 12,
      "stepId": "s01",
      "sceneId": "copies-everywhere",
      "say": "You may think you have one copy. A normal web app has many.",
      "file": "13-copies-everywhere-s01.png"
    },
    {
      "index": 13,
      "stepId": "s02",
      "sceneId": "copies-everywhere",
      "say": "A database replica holds one.",
