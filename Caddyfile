{
  admin off
  auto_https off
}

:80 {
  root * /srv
  encode zstd gzip

  # Kamal / load balancer health check
  handle /up {
    respond "OK" 200
  }

  # Hashed build assets can be cached forever
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"

  # Everything else: SPA fallback to index.html (never cache the shell)
  handle {
    header Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}
